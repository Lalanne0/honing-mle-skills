# Copy to backend/.env (gitignored). The app reads these values from that file only;
# never export them in your shell, and never log or print LLM_API_KEY.

# OpenAI-compatible LLM gateway (LiteLLM proxy). Must be https unless it runs on loopback.
LLM_BASE_URL=
LLM_API_KEY=
# Model name as the gateway exposes it.
LLM_MODEL=anthropic/claude-sonnet-5-5

# "real" calls the gateway; "fake" uses the deterministic FakeLLM (tests, e2e).
LLM_MODE=real
